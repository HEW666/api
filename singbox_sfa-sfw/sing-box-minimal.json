{
  "log": { "level": "info", "timestamp": false },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:20123",
      "external_ui_download_detour": "🎯 全球直连",
      "secret": "CHANGE_ME_BEFORE_USE",
      "default_mode": "rule",
      "access_control_allow_private_network": false
    },
    "cache_file": { "enabled": true, "path": "cache.db" }
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "address": ["172.18.0.1/30", "fdfe:dcba:9876::1/126"],
      "mtu": 1480,
      "dns_mode": "hijack",
      "auto_route": true,
      "strict_route": true
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "set_system_proxy": false
    }
  ],
  "outbounds": [
    { "type": "selector", "tag": "🚀 节点选择", "interrupt_exist_connections": true, "outbounds": [] },
    { "type": "direct", "tag": "🎯 全球直连" },
    { "type": "selector", "tag": "🐟 漏网之鱼", "interrupt_exist_connections": true, "outbounds": ["🚀 节点选择", "🎯 全球直连"] }
  ],
  "route": {
    "rules": [
      { "action": "sniff", "inbound": ["tun-in", "mixed-in"] },
      { "action": "hijack-dns", "protocol": "dns" },
      { "action": "reject", "protocol": "quic" },
      { "action": "reject", "rule_set": ["Ads"] },
      { "action": "route", "clash_mode": "direct", "outbound": "🎯 全球直连" },
      { "action": "route", "clash_mode": "global", "outbound": "🚀 节点选择" },
      { "action": "route", "rule_set": ["GeoSite-Private", "GeoIP-Private"], "outbound": "🎯 全球直连" },
      { "action": "route", "rule_set": ["GeoSite-CN", "GeoIP-CN"], "outbound": "🎯 全球直连" }
    ],
    "rule_set": [
      { "tag": "Ads", "type": "remote", "format": "binary", "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs", "http_client": { "detour": "🚀 节点选择" } },
      { "tag": "GeoSite-Private", "type": "remote", "format": "binary", "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs", "http_client": { "detour": "🚀 节点选择" } },
      { "tag": "GeoIP-Private", "type": "remote", "format": "binary", "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/private.srs", "http_client": { "detour": "🚀 节点选择" } },
      { "tag": "GeoSite-CN", "type": "remote", "format": "binary", "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-cn.srs", "http_client": { "detour": "🚀 节点选择" } },
      { "tag": "GeoIP-CN", "type": "remote", "format": "binary", "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs", "http_client": { "detour": "🚀 节点选择" } }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": { "server": "Local-DNS" },
    "final": "🚀 节点选择"
  },
  "dns": {
    "servers": [
      { "tag": "Local-DNS", "type": "tls", "server": "223.5.5.5", "server_port": 853 },
      { "tag": "Remote-DNS", "type": "tls", "server": "8.8.8.8", "server_port": 853, "detour": "🚀 节点选择" }
    ],
    "rules": [
      { "action": "route", "clash_mode": "direct", "server": "Local-DNS" },
      { "action": "route", "clash_mode": "global", "server": "Remote-DNS" },
      { "action": "route", "rule_set": ["GeoSite-Private", "GeoSite-CN"], "server": "Local-DNS" }
    ],
    "final": "Remote-DNS",
    "reverse_mapping": true
  }
}
